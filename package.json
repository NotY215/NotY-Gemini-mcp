{
  "name": "noty-gemini-mcp",
  "version": "1.0.0",
  "description": "Gemini MCP integration for VS Code",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "author": "NotY",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "electron": "^27.3.11",
    "electron-store": "^8.2.0",
    "express": "^4.21.1",
    "ws": "^8.18.0",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.noty.geminimcp",
    "productName": "NotY-Gemini-MCP",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}